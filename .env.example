# Copy to .env and adjust. Nuxt maps NUXT_PUBLIC_* onto runtimeConfig.public (see nuxt.config.ts).

# Laravel API (php artisan serve --host=127.0.0.1 --port=8000)
NUXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api

# Only a hint on the sign-in/register forms; the server's STUDENT_EMAIL_DOMAIN is what's enforced. Keep the two in step.
NUXT_PUBLIC_STUDENT_EMAIL_DOMAIN=davao.sti.edu.ph
